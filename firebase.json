{
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        ".git",
        ".runtimeconfig.json",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "node_modules",
        "coverage",
        "tests",
        ".env",
        ".env.*",
        ".secret.local"
      ],
      "predeploy": ["pnpm --dir \"$PROJECT_DIR\" --filter artportfolio-backend build"]
    },
    {
      "source": "site",
      "codebase": "site",
      "runtime": "nodejs22",
      "ignore": [
        ".astro",
        "coverage",
        "node_modules",
        "scripts",
        "src",
        "tests",
        ".env",
        ".env.*",
        "*.log"
      ],
      "predeploy": ["pnpm --dir \"$PROJECT_DIR\" --filter site build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist/hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": [
      "pnpm --dir \"$PROJECT_DIR\" --filter front build",
      "pnpm --dir \"$PROJECT_DIR\" --filter site build",
      "node \"$PROJECT_DIR/scripts/build-hosting.mjs\""
    ],
    "redirects": [
      {
        "regex": "^/admin$",
        "destination": "/admin/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "europe-west1",
          "pinTag": true
        }
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "**",
        "function": {
          "functionId": "site",
          "region": "europe-west1",
          "pinTag": true
        }
      }
    ],
    "headers": [
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/admin/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 5502
    },
    "functions": {
      "port": 5501
    },
    "hosting": {
      "port": 5500
    },
    "storage": {
      "port": 5503
    },
    "tasks": {
      "port": 5504
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
