---
/**
 * The switch of languages: the code of the language of the page, which opens the list of all the
 * languages of the site, each by its own name. An item is a plain link to the same page in that
 * language, so it works without a script and a search engine follows it.
 */
import Dropdown from "@/components/ui/Dropdown.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { languageName } from "@/lib/i18n/languageName";
import { type Language, languages } from "@/lib/i18n/languages";
import { languageTag } from "@/lib/i18n/languageTag";
import { t } from "@/lib/i18n/translate";
import { localizedPath } from "@/lib/site/localizedPath";

interface Props {
  class?: string;
  /** The id of the list, unique on the page. */
  id: string;
  language: Language;
  /** The path of the page being shown under its language, such as `/contact`. */
  path: string;
}

const { class: className, id, language, path } = Astro.props;
---

<Dropdown
  class={className}
  id={id}
  label={language.toUpperCase()}
  name={t(language, "header.language")}
>
  <ul class="languages" style={`--rows: ${Math.ceil(languages.length / 2)}`}>
    {
      languages.map((other) => (
        <li lang={languageTag(other)}>
          <TextLink
            class="language"
            aria-current={other === language ? "page" : undefined}
            href={localizedPath(other, path)}
            hreflang={languageTag(other)}
            label={languageName(other)}
          />
        </li>
      ))
    }
  </ul>
</Dropdown>

<style>
  /*
   * Two columns read from top to bottom, the main languages of the site first: the 26 fit a screen
   * without a scroll. The text is the size of the body rather than of the button: a long list in
   * the large type of the mockup, made for three languages, would crowd the page.
   */
  .languages {
    display: grid;
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-flow: column;
    column-gap: var(--space-8);
    padding: 0;
    margin: 0;
    font-size: var(--font-size-body);
    list-style: none;
  }

  .languages > li {
    display: flex;
  }

  /* The rows stand closer under a mouse; on a touch screen they stay as high as a finger needs. */
  @media (pointer: fine) {
    .languages .language {
      min-block-size: 2.25em;
    }
  }
</style>
