---
/**
 * The switch of languages: a globe and the code of the language of the page, which opens the list of all the
 * languages of the site, each by its own name. An item is a plain link to the same page in that
 * language, so it works without a script and a search engine follows it. The script takes the
 * anchor of the address along, such as the project open in the list of projects: an anchor is the
 * same in every language.
 */
import Dropdown from "@/components/ui/Dropdown.astro";
import GlobeIcon from "@/components/ui/icons/GlobeIcon.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { languageName } from "@/lib/i18n/languageName";
import type { Language } from "@/lib/i18n/languages";
import { languagesByName } from "@/lib/i18n/languagesByName";
import { languageTag } from "@/lib/i18n/languageTag";
import { t } from "@/lib/i18n/translate";
import { localizedPath } from "@/lib/site/localizedPath";

interface Props {
  /** Which edge of the button the list lines up with; see Dropdown. */
  align?: "start" | "end";
  class?: string;
  /** The id of the list, unique on the page. */
  id: string;
  language: Language;
  /** The path of the page being shown under its language, such as `/contact`. */
  path: string;
}

const { align, class: className, id, language, path } = Astro.props;

const ordered = languagesByName();
---

<Dropdown
  align={align}
  class={className}
  id={id}
  label={language.toUpperCase()}
  name={t(language, "header.language")}
>
  <GlobeIcon slot="icon" />
  <ul class="languages" data-languages style={`--rows: ${Math.ceil(ordered.length / 2)}`}>
    {
      ordered.map((other) => (
        <li lang={languageTag(other)}>
          <TextLink
            class="language"
            aria-current={other === language ? "page" : undefined}
            href={localizedPath(other, path)}
            hreflang={languageTag(other)}
            label={languageName(other)}
          />
        </li>
      ))
    }
  </ul>
</Dropdown>

<script>
  /**
   * The anchor of the address, set as the visitor follows a link to another language: the page
   * changes its anchor as they open and shut its parts, without telling the links.
   */
  function takeAnchor(event: MouseEvent): void {
    const link =
      event.target instanceof Element
        ? event.target.closest<HTMLAnchorElement>("[data-languages] a[href]")
        : null;

    if (link) link.hash = window.location.hash;
  }

  // A click opens a link, a click of the middle button opens it in a new tab.
  document.addEventListener("click", takeAnchor);
  document.addEventListener("auxclick", takeAnchor);
</script>

<style>
  /*
   * Two columns read from top to bottom, by script and by name: the 26 fit a screen
   * without a scroll. The text is the size of the body rather than of the button: a long list in
   * the large type of the mockup, made for three languages, would crowd the page.
   */
  .languages {
    display: grid;
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-flow: column;
    column-gap: var(--space-8);
    padding: 0;
    margin: 0;
    font-size: var(--font-size-body);
    list-style: none;
  }

  .languages > li {
    display: flex;
  }

  /* The rows stand closer under a mouse; on a touch screen they stay as high as a finger needs. */
  @media (pointer: fine) {
    .languages .language {
      min-block-size: 2.25em;
    }
  }
</style>
