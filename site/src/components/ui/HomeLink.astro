---
/**
 * The name of the artist that leads to the home page, as a logo: in Latin capitals in every
 * language, which a translator of the browser leaves as it is, and on one line. Its size comes
 * from where it stands; where that gives `--home-link-room`, the width it may take, the name gets
 * smaller to fit it rather than run off the screen, as with a large text size of the browser.
 */
import type { HTMLAttributes } from "astro/types";

import type { Language } from "@/lib/i18n/languages";
import { artistName } from "@/lib/site/artistName";
import { localizedPath } from "@/lib/site/localizedPath";

interface Props extends HTMLAttributes<"a"> {
  language: Language;
  /** Whether the home page is the page being shown. */
  current?: boolean;
}

const { class: className, current = false, language, ...attributes } = Astro.props;
---

<a
  aria-current={current ? "page" : undefined}
  class:list={["home-link", className]}
  data-press
  href={localizedPath(language, "/")}
  lang="en"
  translate="no"
  {...attributes}
>
  {artistName}
</a>

<style>
  .home-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--min-tap-target-size);
    /*
     * «ANASTASIA TURKEVICH» in Absans, its capitals spaced, is about 12.33 times as wide as its
     * size; 12.5 leaves it a little air. Without a room, the room is the screen.
     */
    font-size: min(1em, var(--home-link-room, 100vw) / 12.5);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
    white-space: nowrap;
    text-decoration: none;
    transition: letter-spacing var(--motion-duration-release) var(--motion-easing-release);
  }

  /*
   * Pressed, the letters of the name draw together, as a breath before going home, and spring
   * apart as it is let go. The name only gets narrower: nothing after it on its line moves.
   */
  .home-link:active {
    letter-spacing: -0.03em;
    transition-timing-function: var(--motion-easing-press);
    transition-duration: var(--motion-duration-press);
  }
</style>
