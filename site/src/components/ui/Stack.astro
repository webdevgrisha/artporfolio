---
/** Puts its children one under another with the same space between each. */
import type { HTMLTag, Polymorphic } from "astro/types";

/** The spacing tokens a stack may use, from `styles/tokens/spacing.css`. */
type StackGap =
  | "space-2"
  | "space-4"
  | "space-6"
  | "space-8"
  | "layout-space-4"
  | "layout-space-6"
  | "layout-space-8"
  | "layout-space-10"
  | "layout-space-12"
  | "layout-space-16"
  | "layout-space-24"
  | "layout-space-32";

type Props<Tag extends HTMLTag> = Polymorphic<{
  as: Tag;
  /** The space between the children: fixed inside a component, growing between blocks. */
  gap?: StackGap;
}>;

const { as: Tag = "div", class: className, gap = "space-4", ...attributes } = Astro.props;
---

<Tag class:list={["stack", className]} style={`--stack-gap: var(--${gap})`} {...attributes}>
  <slot />
</Tag>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--stack-gap);
  }
</style>
