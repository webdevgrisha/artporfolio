---
/**
 * A button that opens a panel under it, such as the list of languages: the label, after an icon
 * when the `icon` slot has one, with a chevron, as in the mockup, and the panel in a box with a shadow. The panel is a popover: the browser
 * opens and closes it, by Escape or a click beside it too, without a script.
 */
import type { HTMLAttributes } from "astro/types";

import ChevronDownIcon from "./icons/ChevronDownIcon.astro";
import VisuallyHidden from "./VisuallyHidden.astro";

interface Props extends Omit<HTMLAttributes<"div">, "id"> {
  /**
   * Which edge of the button the panel lines up with: its start, or its end for a button at the
   * end of a row, so the panel never reaches past the margin of the page.
   */
  align?: "start" | "end" | undefined;
  /** The id of the panel, unique on the page; the button opens the panel by it. */
  id: string;
  /** What the button shows, such as «EN». */
  label: string;
  /**
   * What the button chooses, such as «Language»: screen readers say it before the label, which
   * alone would not tell.
   */
  name: string;
}

const { align = "start", class: className, id, label, name, ...attributes } = Astro.props;
---

<div class:list={["dropdown", className]} {...attributes}>
  <button class="trigger" popovertarget={id} style={`anchor-name: --${id}`} type="button">
    <VisuallyHidden>{name}</VisuallyHidden>
    <slot name="icon" />
    {/* A script may change it, such as to the currency the visitor picked. */}
    <span class="label" data-dropdown-label>{label}</span>
    <ChevronDownIcon />
  </button>
  <div class="panel" data-align={align} id={id} popover style={`position-anchor: --${id}`}>
    <div class="content">
      <slot />
    </div>
  </div>
</div>

<style>
  /* The button alone sets the height, so the label stands level with any other in its row. */
  .dropdown {
    display: flex;
  }

  .trigger {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    min-block-size: var(--min-tap-target-size);
    padding: 0;
    color: inherit;
    cursor: pointer;
    background: none;
    border: 0;
    transition: opacity var(--motion-duration-slow) var(--motion-easing-standard);
  }

  @media (hover: hover) {
    .trigger:hover {
      opacity: 0.6;
    }
  }

  .label {
    text-box: trim-both cap alphabetic;
  }

  /* The chevron turns up while the panel is open, and back down as it closes. */
  .trigger :global(.chevron-down) {
    transition: rotate var(--motion-duration-standard) var(--motion-easing-standard);
  }

  .dropdown:has(.panel:popover-open) .trigger :global(.chevron-down) {
    rotate: 180deg;
  }

  /*
   * Under the button, from its start as in the mockup, or from its end; where there is no room
   * there, the browser moves it to the other side, so it keeps the width of its lines rather than
   * break their words. Above or below the button, it takes the side with more room, and never
   * reaches past the screen: a list longer than the room scrolls (see `.content`). A browser that
   * cannot place it by the button shows it in the middle of the screen.
   */
  .panel {
    inline-size: max-content;
    max-inline-size: calc(100vi - 2 * var(--page-gutter));
    /* Of the room on its side of the button, as placed by it: a margin of the page short of the edge. */
    max-block-size: calc(100% - var(--page-gutter));
    padding: 0;
    margin: var(--space-1) 0 0;
    position-area: block-end span-inline-end;
    position-try-order: most-block-size;
    position-try-fallbacks: flip-inline, flip-block, flip-block flip-inline;
    font-size: inherit;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--line-width) solid light-dark(transparent, var(--color-line));
    box-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
    /*
     * It unrolls down from the button and rolls back up, as the menu does: it is cut, not moved,
     * so its list stays still; the cut leaves room for the shadow. The browser keeps it in sight
     * until it is rolled up; a screen without motion shows it at once.
     */
    clip-path: inset(0 -1rem 100% -1rem);
    transition-timing-function: var(--motion-easing-standard);
    transition-duration: var(--motion-duration-slow);
    transition-property: clip-path, display, overlay;
    transition-behavior: allow-discrete;
  }

  /* A column, so the list in it can be no higher than the panel and scroll inside it. */
  .panel:popover-open {
    display: flex;
    flex-direction: column;
    clip-path: inset(0 -1rem -1rem -1rem);
  }

  @starting-style {
    .panel:popover-open {
      clip-path: inset(0 -1rem 100% -1rem);
    }
  }

  /*
   * A list longer than the room scrolls, with a thin scrollbar, and fades out at the edge where
   * more of it is hidden, so it shows there is more without a frame: the fade follows the scroll,
   * gone at the top once it reaches the top, and at the bottom at the end. A browser that cannot tie
   * it to the scroll shows the list without it.
   */
  .content {
    --fade-size: var(--space-8);

    min-block-size: 0;
    padding: var(--space-3) var(--space-6);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 var(--fade-start),
      #000 calc(100% - var(--fade-end)),
      transparent
    );
  }

  @supports (animation-timeline: scroll()) {
    .content {
      animation: scroll-fade linear both;
      animation-timeline: scroll(self);
    }
  }

  @property --fade-start {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @property --fade-end {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @keyframes scroll-fade {
    from {
      --fade-start: 0px;
      --fade-end: var(--fade-size);
    }

    10% {
      --fade-start: var(--fade-size);
    }

    90% {
      --fade-end: var(--fade-size);
    }

    to {
      --fade-start: var(--fade-size);
      --fade-end: 0px;
    }
  }

  .panel[data-align="end"] {
    position-area: block-end span-inline-start;
  }
</style>
