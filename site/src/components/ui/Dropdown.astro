---
/**
 * A button that opens a panel under it, such as the list of languages: the label, after an icon
 * when the `icon` slot has one, with a chevron, as in the mockup, and the panel in a box with a shadow. The panel is a popover: the browser
 * opens and closes it, by Escape or a click beside it too, without a script.
 */
import type { HTMLAttributes } from "astro/types";

import ChevronDownIcon from "./icons/ChevronDownIcon.astro";
import VisuallyHidden from "./VisuallyHidden.astro";

interface Props extends Omit<HTMLAttributes<"div">, "id"> {
  /**
   * Which edge of the button the panel lines up with: its start, or its end for a button at the
   * end of a row, so the panel never reaches past the margin of the page.
   */
  align?: "start" | "end" | undefined;
  /** The id of the panel, unique on the page; the button opens the panel by it. */
  id: string;
  /** What the button shows, such as «EN». */
  label: string;
  /**
   * What the button chooses, such as «Language»: screen readers say it before the label, which
   * alone would not tell.
   */
  name: string;
}

const { align = "start", class: className, id, label, name, ...attributes } = Astro.props;
---

<div class:list={["dropdown", className]} {...attributes}>
  <button class="trigger" popovertarget={id} style={`anchor-name: --${id}`} type="button">
    <VisuallyHidden>{name}</VisuallyHidden>
    <slot name="icon" />
    {/* A script may change it, such as to the currency the visitor picked. */}
    <span class="label" data-dropdown-label>{label}</span>
    <ChevronDownIcon />
  </button>
  <div class="panel" data-align={align} id={id} popover style={`position-anchor: --${id}`}>
    <slot />
  </div>
</div>

<style>
  /* The button alone sets the height, so the label stands level with any other in its row. */
  .dropdown {
    display: flex;
  }

  .trigger {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
    min-block-size: var(--min-tap-target-size);
    padding: 0;
    color: inherit;
    cursor: pointer;
    background: none;
    border: 0;
    transition: opacity var(--motion-duration-slow) var(--motion-easing-standard);
  }

  @media (hover: hover) {
    .trigger:hover {
      opacity: 0.6;
    }
  }

  .label {
    text-box: trim-both cap alphabetic;
  }

  /* The chevron turns up while the panel is open, and back down as it closes. */
  .trigger :global(.chevron-down) {
    transition: rotate var(--motion-duration-standard) var(--motion-easing-standard);
  }

  .dropdown:has(.panel:popover-open) .trigger :global(.chevron-down) {
    rotate: 180deg;
  }

  /*
   * Under the button, from its start as in the mockup, or from its end; where there is no room
   * there, the browser moves it to the other side, so it keeps the width of its lines rather than
   * break their words. A browser that cannot place it by the button shows it in the middle of the
   * screen.
   */
  .panel {
    inline-size: max-content;
    max-inline-size: calc(100vi - 2 * var(--page-gutter));
    max-block-size: calc(100dvh - 2 * var(--page-gutter));
    padding: var(--space-3) var(--space-6);
    margin: var(--space-1) 0 0;
    position-area: block-end span-inline-end;
    position-try-fallbacks: flip-inline, flip-block, flip-block flip-inline;
    overflow-y: auto;
    font-size: inherit;
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--line-width) solid light-dark(transparent, var(--color-line));
    box-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
    /*
     * It fades in and out, as everything that pops up over the page comes and goes with motion:
     * only fades, as the browser may place it above the button as well as below. The browser
     * keeps it in sight until it has faded out; a screen without motion shows it at once.
     */
    opacity: 0;
    transition-timing-function: var(--motion-easing-standard);
    transition-duration: var(--motion-duration-standard);
    transition-property: opacity, display, overlay;
    transition-behavior: allow-discrete;
  }

  .panel:popover-open {
    opacity: 1;
  }

  @starting-style {
    .panel:popover-open {
      opacity: 0;
    }
  }

  .panel[data-align="end"] {
    position-area: block-end span-inline-start;
  }
</style>
