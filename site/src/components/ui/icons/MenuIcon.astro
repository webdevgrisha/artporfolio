---
/**
 * The two lines of the mockup that open the menu: wider than an icon of the grid, as drawn there,
 * in the color of the text. Drawn for the site.
 */
---

<svg
  aria-hidden="true"
  class="menu-icon"
  fill="none"
  focusable="false"
  stroke="currentColor"
  stroke-width="2"
  viewBox="0 0 32 14"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M0 1h32M0 13h32" />
</svg>

<style>
  /* 31 by 14px beside a text of 24px, as in the mockup. */
  .menu-icon {
    flex-shrink: 0;
    inline-size: 1.3em;
    block-size: auto;
  }
</style>
