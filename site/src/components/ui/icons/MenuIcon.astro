---
/**
 * The two lines of the mockup that open the menu, wider than an icon of the grid, as drawn there.
 * They turn into a cross that closes it: `--menu-icon-cross` from 0 to 1 brings each line to the
 * middle and turns it by 45°, so a transition of it draws the one into the other. Drawn for the
 * site.
 */
---

<svg
  aria-hidden="true"
  class="menu-icon"
  fill="none"
  focusable="false"
  stroke="currentColor"
  stroke-width="2"
  viewBox="0 0 32 14"
  xmlns="http://www.w3.org/2000/svg"
>
  <path class="line top" d="M0 7h32" />
  <path class="line bottom" d="M0 7h32" />
</svg>

<style>
  /* A number, so a transition can move it, and inherited, so the button around sets it. */
  @property --menu-icon-cross {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* 31 by 14px beside a text of 24px, as in the mockup; the cross reaches past that box. */
  .menu-icon {
    flex-shrink: 0;
    inline-size: var(--menu-icon-size, 1.3em);
    block-size: auto;
    overflow: visible;
  }

  /*
   * Both lines are drawn in the middle and moved 6 units apart, to the top and the bottom; as
   * they cross, they come back to the one place they are drawn in, and each turns about its own
   * middle. So the cross meets at the middles of its lines in every browser, however it rounds a
   * move: Safari, which drew them at the top and the bottom and moved them toward each other,
   * turned them about a point given in pixels of the drawing, and its cross came out crooked.
   *
   * Two lines of 32 crossed at a right angle make a cross of about 23 by 23 (32 × cos 45°), the
   * size of the one in the mockup. It then moves the 4.7 units it is narrower on each side to the
   * end of the line, so it ends where the page ends, as the lines did.
   */
  .line {
    --end: 1;

    transform-origin: center;
    transform-box: fill-box;
    rotate: calc(var(--menu-icon-cross) * var(--turn));
    translate: calc(var(--menu-icon-cross) * var(--end) * 4.69px)
      calc((1 - var(--menu-icon-cross)) * var(--side) * 6px);
  }

  /* The end of the line is on the left in a text from the right. */
  .menu-icon:dir(rtl) .line {
    --end: -1;
  }

  .top {
    --turn: 45deg;
    --side: -1;
  }

  .bottom {
    --turn: -45deg;
    --side: 1;
  }
</style>
