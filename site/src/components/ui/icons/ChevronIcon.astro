---
/**
 * The thin arrow of the mockup that sends a field: half as wide as it is high, drawn with the line
 * of the field under it. It points forward: to the right, or to the left in Arabic.
 */
---

<svg
  aria-hidden="true"
  class="chevron"
  fill="none"
  focusable="false"
  stroke="currentColor"
  viewBox="0 0 12 24"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M1 1 11 12 1 23" vector-effect="non-scaling-stroke" />
</svg>

<style>
  .chevron {
    flex-shrink: 0;
    inline-size: 0.5em;
    block-size: 1em;
  }

  /* As thin as the line of the field at every size. */
  .chevron path {
    stroke-width: var(--line-width);
  }

  .chevron:dir(rtl) {
    scale: -1 1;
  }
</style>
