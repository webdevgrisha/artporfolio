---
/**
 * The frame of an icon: a line drawing on a 24-unit grid in the color of the text, at the size of
 * the text. It only decorates the text next to it, so screen readers skip it.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  class:list={["icon", className]}
  fill="none"
  focusable="false"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.5"
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
>
  <slot />
</svg>

<style>
  .icon {
    flex-shrink: 0;
    inline-size: 1em;
    block-size: 1em;
  }
</style>
