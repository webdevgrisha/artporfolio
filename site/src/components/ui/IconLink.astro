---
/** A link whose text follows an icon (the `icon` slot), with room enough for a finger. */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  /** The text of the link, which also names it for screen readers: the icon only decorates it. */
  label: string;
}

const { class: className, href, label, ...attributes } = Astro.props;
---

<a class:list={["icon-link", className]} href={href} {...attributes}>
  <slot name="icon" />
  <span class="text">{label}</span>
</a>

<style>
  .icon-link {
    display: inline-flex;
    gap: 0.75em;
    align-items: center;
    min-block-size: var(--min-tap-target-size);
    text-decoration: none;
  }

  /*
   * A long address breaks rather than widen the page on a phone. The box of the text ends at the
   * top of its capitals and at its baseline, so the link lines up with what is beside it.
   */
  .text {
    text-box: trim-both cap alphabetic;
    overflow-wrap: anywhere;
    /*
     * The underline is always there, only unseen: under the pointer it shows and rises to the
     * text, so it comes in softly instead of at once. A screen without motion shows it at once.
     */
    text-decoration-line: underline;
    text-decoration-thickness: var(--line-width);
    text-decoration-color: transparent;
    text-underline-offset: 0.45em;
    transition-timing-function: var(--motion-easing-standard);
    transition-duration: var(--motion-duration-slow);
    transition-property: text-decoration-color, text-underline-offset;
  }

  /* Only under a pointer: a tap on a phone would leave the link underlined. */
  @media (hover: hover) {
    .icon-link:hover .text {
      text-decoration-color: currentColor;
      text-underline-offset: 0.2em;
    }
  }
</style>
