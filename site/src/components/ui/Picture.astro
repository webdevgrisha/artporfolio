---
/**
 * An image of the API in the best format the browser reads, AVIF else WebP, at the width it
 * shows the image at. It fills its box, cropped to it if the box has another shape. Until it
 * loads, its preview holds its place, blurred: the colors and the shapes of the image at once.
 */
import type { HTMLAttributes } from "astro/types";

import type { Image } from "@/lib/api/image";
import { srcset } from "@/lib/images/srcset";

// The style of the picture is its own: it carries the preview.
interface Props extends Omit<HTMLAttributes<"picture">, "style"> {
  alt: string;
  /**
   * Whether the image waits for a script of the page to load it (`loadDeferredImages`), such as a
   * slide not shown yet: lying where the visitor looks, it would load at once even when lazy.
   */
  deferred?: boolean;
  image: Image;
  /**
   * Whether the visitor sees the image first: it then loads at once, before other images,
   * instead of when it nears the screen. Only the largest image of the first screen needs it.
   */
  priority?: boolean;
  /** How wide the image is shown at each width of the page, as `sizes` of <img>. */
  sizes: string;
}

const {
  alt,
  class: className,
  deferred = false,
  image,
  priority = false,
  sizes,
  ...attributes
} = Astro.props;
const { avif, webp } = image.sources;
const fallback = webp.at(-1)?.url;

/** The files of the image, in data attributes while it is deferred, for the script to move. */
function files(value: string) {
  return deferred ? { "data-deferred-srcset": value } : { srcset: value };
}
---

<picture
  class:list={["picture", className]}
  style={`--placeholder: url("${image.placeholder}")`}
  {...attributes}
>
  <source type="image/avif" sizes={sizes} {...files(srcset(avif))} />
  <img
    alt={alt}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
    height={image.height}
    loading={priority ? "eager" : "lazy"}
    sizes={sizes}
    width={image.width}
    {...(deferred ? { "data-deferred-src": fallback } : { src: fallback })}
    {...files(srcset(webp))}
  />
</picture>

<style>
  /*
   * Holds the place of the image while it loads, under it, so the image fades in over it: the
   * preview, stretched as the image will be and blurred so its pixels do not show, over the color
   * of a placeholder, which shows at its edges. Without weight, so the page that places the
   * picture, as absolute behind a link for one, always wins.
   */
  :where(.picture) {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .picture::before {
    position: absolute;
    inset: 0;
    content: "";
    background: var(--placeholder) center / cover no-repeat;
    filter: blur(1rem);
    /* The blur fades the edges: a little larger, the preview keeps them full. */
    scale: 1.1;
  }

  img {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>
