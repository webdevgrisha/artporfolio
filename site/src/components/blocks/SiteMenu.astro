---
/**
 * The menu the button of the header opens: a panel over the top of the page, as in the mockup,
 * with the name of the artist and the button that closes it where the header has its own, the
 * pages large, and the ways to reach the artist with the year at the bottom. The year stands alone,
 * as in the mockup: the sign of copyright is the footer's.
 *
 * It is a popover: the browser opens it from the button of the header and closes it from its own
 * button, by Escape or by a click beside it, without a script. It unrolls down from the header,
 * whose name and button stay where they are: the two lines of the button turn into the cross that
 * closes it, and the pages come in one after another.
 */
import NetworkLinks from "@/components/blocks/NetworkLinks.astro";
import CurrencySwitch from "@/components/controls/CurrencySwitch.astro";
import LanguageSwitch from "@/components/controls/LanguageSwitch.astro";
import ThemeToggle from "@/components/controls/ThemeToggle.astro";
import Container from "@/components/ui/Container.astro";
import HomeLink from "@/components/ui/HomeLink.astro";
import MenuIcon from "@/components/ui/icons/MenuIcon.astro";
import Picture from "@/components/ui/Picture.astro";
import TextLink from "@/components/ui/TextLink.astro";
import type { ContactLinks } from "@/lib/api/contacts";
import type { Image } from "@/lib/api/image";
import type { Language } from "@/lib/i18n/languages";
import { t } from "@/lib/i18n/translate";
import { localizedPath } from "@/lib/site/localizedPath";
import { menu } from "@/lib/site/menu";
import { longestWordLength } from "@/lib/text/longestWord";

interface Props {
  /** The codes of the currencies in use, for the switch of currencies. */
  currencies: string[];
  /** The heroes of the pages by their id: each fills the plate of its page under the pointer. */
  heroes: Record<string, Image>;
  /** The id the button of the header opens the menu by. */
  id: string;
  language: Language;
  /** The links of the artist; none when the API could not give them. */
  links: ContactLinks | undefined;
  /** The path of the page being shown under its language, such as `/contact`. */
  path: string | undefined;
}

const { currencies, heroes, id, language, links, path } = Astro.props;

// The year of the page as it is served, as in the footer.
const year = new Date().getFullYear();

// The names of the pages in this language, and the letters of the longest word among them, which
// sets their size where the column is narrow.
const pageNames = menu.map((page) => t(language, page.label));
const longestWord = Math.max(...pageNames.map(longestWordLength));
---

<div class="site-menu" data-site-menu id={id} popover>
  <Container class="panel">
    <HomeLink class="name" current={path === "/"} language={language} />
    <button
      class="close"
      data-menu-close
      popovertarget={id}
      popovertargetaction="hide"
      type="button"
    >
      <span class="close-text">{t(language, "header.close")}</span>
      <MenuIcon />
    </button>
    <nav aria-label={t(language, "header.menu")} class="pages">
      <ul class="page-list" style={{ "--longest-word": longestWord }}>
        {
          menu.map((page, index) => {
            const hero = page.page === undefined ? undefined : heroes[page.page];

            return (
              <li style={`--item: ${index}`}>
                <TextLink
                  class:list={["page-link", { "with-hero": hero }]}
                  aria-current={page.path === path ? "page" : undefined}
                  href={localizedPath(language, page.path)}
                  label={t(language, page.label)}
                >
                  {hero && (
                    <Picture
                      alt=""
                      class="hero"
                      image={hero}
                      sizes="(width >= 75rem) 10vw, 25vw"
                      slot="icon"
                    />
                  )}
                </TextLink>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="settings">
      <CurrencySwitch currencies={currencies} id="menu-currency" language={language} />
      {
        path !== undefined && (
          <LanguageSwitch id="menu-language" language={language} path={path} />
        )
      }
      <ThemeToggle language={language} />
    </div>
    {
      links && (
        <div class="contacts">
          <NetworkLinks class="networks" label={t(language, "footer.networks")} links={links} />
          {links.email !== "" && (
            <TextLink class="email" href={`mailto:${links.email}`} label={links.email} />
          )}
        </div>
      )
    }
    <p class="year">{year}</p>
  </Container>
</div>

<script>
  /*
   * While the menu is open, everything around it is inert, as behind a modal dialog: the keyboard
   * and screen readers stay in the menu, and its button that closes it takes the focus. A click
   * beside it still closes it. As it closes, the page comes back first, so the browser can return
   * the focus to the button of the header.
   */
  const menu = document.querySelector<HTMLElement>("[data-site-menu]");

  /** Makes inert, or gives back, every element beside the menu and beside each of its ancestors. */
  function setPageInert(inert: boolean, element: HTMLElement): void {
    for (let node: HTMLElement | null = element; node && node !== document.body; ) {
      const parent: HTMLElement | null = node.parentElement;

      for (const sibling of parent?.children ?? []) {
        if (sibling !== node && sibling instanceof HTMLElement) sibling.inert = inert;
      }
      node = parent;
    }
  }

  if (menu) {
    menu.addEventListener("beforetoggle", (event) => {
      setPageInert((event as ToggleEvent).newState === "open", menu);
    });
    menu.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "open") {
        menu.querySelector<HTMLElement>("[data-menu-close]")?.focus();
      }
    });
  }
</script>

<style>
  /*
   * A panel across the top of the screen, over the page, with the shadow of the mockup under it.
   * On a phone it takes the whole screen; from a tablet on it leaves the bottom of the page in
   * sight, as in the mockup. Higher than the screen, it scrolls itself, and the page under it
   * stays where it was.
   */
  .site-menu {
    inset: 0 0 auto;
    inline-size: 100%;
    max-inline-size: none;
    min-block-size: 100dvh;
    max-block-size: 100dvh;
    padding: 0;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--color-text);
    background: var(--color-surface);
    border: 0;
    box-shadow: 0 4px 4px rgb(0 0 0 / 0.25);
    /*
     * It unrolls from the top of the screen and rolls back up: it is cut, not moved, so what it
     * holds stays still and its name and button cover those of the header exactly. The cut leaves
     * room for the shadow below. The browser keeps it in sight until it is rolled up; on a screen
     * without motion it comes and goes at once.
     */
    clip-path: inset(0 0 100% 0);
    transition-timing-function: var(--motion-easing-standard);
    transition-duration: var(--motion-duration-panel);
    transition-property: clip-path, display, overlay;
    transition-behavior: allow-discrete;
  }

  .site-menu:popover-open {
    clip-path: inset(0 0 -1rem 0);
  }

  @starting-style {
    .site-menu:popover-open {
      clip-path: inset(0 0 100% 0);
    }
  }

  @media (width >= 40rem) {
    .site-menu {
      min-block-size: 80dvh;
    }
  }

  /* The page under the open menu does not scroll with it. */
  :global(html:has(.site-menu:popover-open)) {
    overflow: hidden;
  }

  /*
   * The name and the button that closes the menu stand where the name and the button that opens
   * it stand in the header, so the panel seems to open around them. Below, the pages, then the
   * ways to reach the artist at the bottom.
   */
  .panel {
    --menu-font-size: var(--font-size-body);

    display: grid;
    grid-template-areas:
      "name close"
      "pages pages"
      "settings settings"
      "contacts contacts"
      "year year";
    grid-template-rows: auto 1fr auto auto auto;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--layout-space-8) var(--grid-gap);
    min-block-size: inherit;
    padding-block: var(--layout-space-6) var(--layout-space-8);
    font-size: var(--menu-font-size);
  }

  /*
   * On a laptop, as in the mockup: the name and the year in the first two thirds, everything else
   * in the last third, from the button that closes the menu down to the ways to reach the artist.
   */
  @media (width >= 75rem) {
    .panel {
      grid-template-areas:
        "name close"
        ". pages"
        "year contacts";
      grid-template-rows: auto 1fr auto;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .name {
    grid-area: name;
    justify-self: start;
  }

  /* The word, then the cross at the end of the page, where the header has the button that opens. */
  .close {
    display: flex;
    grid-area: close;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    justify-self: end;
    min-block-size: var(--min-tap-target-size);
    padding: 0;
    color: inherit;
    cursor: pointer;
    background: none;
    border: 0;
    transition:
      opacity var(--motion-duration-slow) var(--motion-easing-standard),
      --menu-icon-cross var(--motion-duration-panel) var(--motion-easing-standard);
  }

  /* The lines of the button of the header become a cross as the menu opens, and back as it closes. */
  .site-menu:popover-open .close {
    --menu-icon-cross: 1;
  }

  @starting-style {
    .site-menu:popover-open .close {
      --menu-icon-cross: 0;
    }
  }

  @media (width >= 75rem) {
    .close {
      justify-self: stretch;
    }
  }

  @media (hover: hover) {
    .close:hover {
      opacity: 0.6;
    }
  }

  .close-text {
    text-box: trim-both cap alphabetic;
  }

  .pages {
    grid-area: pages;
    container-type: inline-size;
  }

  /*
   * The switches of the page, which the header shows from 48rem: on a phone they are here,
   * under the pages.
   */
  .settings {
    display: flex;
    flex-wrap: wrap;
    grid-area: settings;
    gap: 0 var(--layout-space-8);
    align-items: center;
  }

  @media (width >= 48rem) {
    .settings {
      display: none;
    }
  }

  .page-list {
    padding: 0;
    margin: 0;
    /*
     * A name never breaks: in a narrow column a language of long names, such as the Dutch
     * «Tentoonstellingen», sets all of them smaller, so its longest word fits the line. A capital
     * of Absans is about 0.8 of its size wide.
     */
    font-size: min(var(--font-size-3), 100cqi / (0.8 * var(--longest-word)));
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
    list-style: none;
  }

  /*
   * One page under another, on the line of everything else in the column; the rows stand apart
   * nearly twice their text, as the plates of the mockup do. As the menu opens, they rise into
   * place one after another.
   */
  .page-list > li {
    display: flex;
    transition-delay: calc(var(--item) * var(--motion-stagger));
    transition-timing-function: var(--motion-easing-standard);
    transition-duration: var(--motion-duration-panel);
    transition-property: opacity, translate;
  }

  .page-list .page-link {
    min-block-size: 1.85em;
  }

  /*
   * Under the pointer, or the focus of the keyboard, the hero of the page fills its plate behind
   * the text, as in the mockup: the plate is as wide as the word and half a letter more on each
   * side, so the text keeps the line of the column. The work is blurred, as the hero is at the
   * top of its page, and darkened so the white text reads on any of them; the underline gives way
   * to it. The blur hides the detail, so a small file is enough. Without a pointer, on a phone, the
   * plates stay plain and their photos are never loaded: a hidden image is not fetched.
   */
  .hero {
    display: none;
  }

  @media (hover: hover) {
    .with-hero {
      position: relative;
      isolation: isolate;
    }

    .hero {
      position: absolute;
      inset: 0 -0.5em;
      z-index: -1;
      display: block;
      inline-size: auto;
      max-inline-size: none;
      block-size: auto;
      opacity: 0;
      transition: opacity var(--motion-duration-slow) var(--motion-easing-standard);
    }

    /* Blurred edges would let the page show through: the photo is cut to the plate, a little larger. */
    .hero {
      overflow: hidden;
    }

    .hero :global(img) {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      filter: blur(0.2em) brightness(0.6);
      scale: 1.15;
    }

    .with-hero {
      transition: color var(--motion-duration-slow) var(--motion-easing-standard);
    }

    .with-hero:is(:hover, :focus-visible) .hero {
      opacity: 1;
    }

    .with-hero:is(:hover, :focus-visible) {
      color: var(--color-on-photo);
    }

    .page-link.with-hero:is(:hover, :focus-visible) :global(.text) {
      text-decoration-color: transparent;
    }
  }

  @starting-style {
    .site-menu:popover-open .page-list > li {
      opacity: 0;
      translate: 0 0.3em;
    }
  }

  /*
   * The ways to reach the artist: the icons of the networks, then the address, which on a phone
   * goes under them rather than break.
   */
  .contacts {
    display: flex;
    flex-wrap: wrap;
    grid-area: contacts;
    gap: 0 var(--layout-space-4);
    align-items: center;
  }

  /* The frame of the first icon, not the room a finger needs around it, starts at the edge. */
  .networks {
    --icon-size: 1.25em;

    margin-inline-start: calc(
      (var(--icon-size) - max(var(--min-tap-target-size), var(--icon-size))) / 2 -
      var(--icon-size) / 12
    );
  }

  .year {
    grid-area: year;
    align-self: end;
    margin: 0;
    line-height: var(--min-tap-target-size);
  }
</style>
