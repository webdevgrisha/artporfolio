---
/**
 * The header of every page: the name of the artist, which leads home, the switches of the page and
 * the link to the gallery on a laptop, and the button that opens the menu of the site. On a
 * smaller screen the switches are in the menu, and the header keeps the name and the button only,
 * as in the mockups.
 */
import SiteMenu from "@/components/blocks/SiteMenu.astro";
import CurrencySwitch from "@/components/controls/CurrencySwitch.astro";
import LanguageSwitch from "@/components/controls/LanguageSwitch.astro";
import ThemeToggle from "@/components/controls/ThemeToggle.astro";
import Container from "@/components/ui/Container.astro";
import HomeLink from "@/components/ui/HomeLink.astro";
import MenuIcon from "@/components/ui/icons/MenuIcon.astro";
import TextLink from "@/components/ui/TextLink.astro";
import type { ContactLinks } from "@/lib/api/contacts";
import type { Language } from "@/lib/i18n/languages";
import { t } from "@/lib/i18n/translate";
import { localizedPath } from "@/lib/site/localizedPath";

interface Props {
  /** The codes of the currencies in use, for the switch of currencies. */
  currencies: string[];
  language: Language;
  /** The links of the artist for the menu; none when the API could not give them. */
  links: ContactLinks | undefined;
  /** The path of the page being shown under its language, such as `/contact`. */
  path: string | undefined;
}

const { currencies, language, links, path } = Astro.props;

const menuId = "site-menu";
---

<header class="site-header" data-site-header>
  <Container class="bar">
    <HomeLink current={path === "/"} language={language} />
    <div class="controls">
      <CurrencySwitch
        align="end"
        currencies={currencies}
        id="header-currency"
        language={language}
      />
      {
        path !== undefined && (
          <LanguageSwitch align="end" id="header-language" language={language} path={path} />
        )
      }
      {/* The works, which the site is for, a click away on every page, as in the mockup. */}
      <TextLink
        aria-current={path === "/gallery" ? "page" : undefined}
        href={localizedPath(language, "/gallery")}
        label={t(language, "menu.gallery")}
      />
      <ThemeToggle language={language} />
    </div>
    <button
      aria-label={t(language, "header.menu")}
      class="menu-button"
      popovertarget={menuId}
      type="button"
    >
      <MenuIcon />
    </button>
  </Container>
  <SiteMenu
    currencies={currencies}
    id={menuId}
    language={language}
    links={links}
    path={path}
  />
</header>

<script>
  /*
   * The header goes out of sight as the visitor scrolls down to read, and comes back as soon as
   * they scroll up, wherever they are: the menu is never far, and the works keep the screen. It
   * stays while the visitor is in it, by the keyboard or with a list of it open. Without this
   * script the header scrolls away with the page, as any other part of it.
   */
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  /** A scroll shorter than this is a tremble of the hand or of the page, not a direction. */
  const minimumScroll = 8;

  if (header) {
    const root = document.documentElement;
    let lastScroll = window.scrollY;

    // A link followed within the page stops below the header, not under it.
    new ResizeObserver(() => {
      root.style.scrollPaddingBlockStart = `${header.offsetHeight}px`;
    }).observe(header);

    header.dataset.smart = "";

    window.addEventListener(
      "scroll",
      () => {
        const scroll = window.scrollY;

        if (Math.abs(scroll - lastScroll) < minimumScroll) return;

        const inUse = header.matches(":focus-within") || header.querySelector(":popover-open");
        const down = scroll > lastScroll && scroll > header.offsetHeight;

        header.toggleAttribute("data-hidden", down && !inUse);
        lastScroll = scroll;
      },
      { passive: true },
    );

    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>

<style>
  /*
   * With its script the header stays at the top of the screen, over the page, and slides out of
   * sight while the visitor scrolls down. A screen without motion shows and hides it at once.
   */
  .site-header[data-smart] {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
    background: var(--color-surface);
    transition: translate var(--motion-duration-slow) var(--motion-easing-standard);
  }

  .site-header[data-hidden] {
    translate: 0 -100%;
  }

  /*
   * One row: the name at the start, the button at the end. Its text is as large as the body on a
   * phone, where the name has to fit beside the button, and as in the mockup from a tablet on.
   */
  .bar {
    display: flex;
    gap: var(--grid-gap);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--layout-space-6);
    font-size: var(--font-size-body);
  }

  @media (width >= 40rem) {
    .bar {
      font-size: var(--font-size-1);
    }
  }

  /* At the end of the row, before the button of the menu, as in the mockup. */
  .controls {
    display: none;
    gap: var(--layout-space-8);
    align-items: center;
    margin-inline-start: auto;
  }

  @media (width >= 75rem) {
    .controls {
      display: flex;
    }
  }

  /*
   * A box a finger can hit, with the lines at its end: they end where the page does, as the cross
   * that closes the menu.
   */
  .menu-button {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: end;
    min-inline-size: var(--min-tap-target-size);
    min-block-size: var(--min-tap-target-size);
    padding: 0;
    color: inherit;
    cursor: pointer;
    background: none;
    border: 0;
    transition: opacity var(--motion-duration-slow) var(--motion-easing-standard);
  }

  @media (hover: hover) {
    .menu-button:hover {
      opacity: 0.6;
    }
  }
</style>
