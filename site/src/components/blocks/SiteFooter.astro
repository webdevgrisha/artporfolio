---
/**
 * The footer of every page: the newsletter, the networks of the artist and the menu of the site,
 * then the name of the artist and the year across the page.
 */
import NewsletterSignup from "@/components/blocks/NewsletterSignup.astro";
import Container from "@/components/ui/Container.astro";
import IconLink from "@/components/ui/IconLink.astro";
import InstagramIcon from "@/components/ui/icons/InstagramIcon.astro";
import LinkedInIcon from "@/components/ui/icons/LinkedInIcon.astro";
import MailIcon from "@/components/ui/icons/MailIcon.astro";
import YouTubeIcon from "@/components/ui/icons/YouTubeIcon.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { type ContactLinks, contactsSchema } from "@/lib/api/contacts";
import { getJson } from "@/lib/api/getJson";
import type { Language } from "@/lib/i18n/languages";
import { t } from "@/lib/i18n/translate";
import { artistName } from "@/lib/site/artistName";
import { localizedPath } from "@/lib/site/localizedPath";
import { menu } from "@/lib/site/menu";

interface Props {
  language: Language;
  /** The path of the page being shown under its language, such as `/contact`; none on an error. */
  path?: string | undefined;
}

const { language, path } = Astro.props;

// The networks only lead elsewhere: a page whose API cannot answer, as an error page may be, still
// shows its footer, without them.
let links: ContactLinks | undefined;

try {
  ({ links } = await getJson("contacts", contactsSchema, { language }));
} catch (error) {
  console.error("The footer is shown without the networks:", error);
}

// Every way to reach the artist, as on the Contacts page: the networks in the order of the mockup,
// then the email, named by its address. A link the artist left empty is not shown. The name of a
// network is English in every language, as on the Contacts page.
const networks = links
  ? [
      { href: links.youtube, Icon: YouTubeIcon, label: "YouTube", lang: "en" },
      { href: links.instagram, Icon: InstagramIcon, label: "Instagram", lang: "en" },
      { href: links.linkedin, Icon: LinkedInIcon, label: "LinkedIn", lang: "en" },
      { href: links.email && `mailto:${links.email}`, Icon: MailIcon, label: links.email },
    ].filter(({ href }) => href !== "")
  : [];

// The year of the page as it is served, never one left in the code.
const year = new Date().getFullYear();
---

<footer>
  <Container class="footer">
    <div class="top" style={`--menu-links: ${menu.length}`}>
      <NewsletterSignup class="signup" language={language} />
      <div class="links">
      {
        networks.length > 0 && (
          <ul aria-label={t(language, "footer.networks")} class="networks">
            {networks.map(({ href, Icon, label, lang }) => (
              <li>
                <IconLink href={href} label={label} lang={lang}>
                  <Icon slot="icon" />
                </IconLink>
              </li>
            ))}
          </ul>
        )
      }
      <nav aria-label={t(language, "footer.menu")} class="menu-nav">
        <ul class="menu">
          {
            menu.map((page) => (
              <li>
                <TextLink
                  class="menu-link"
                  aria-current={page.path === path ? "page" : undefined}
                  href={localizedPath(language, page.path)}
                  label={t(language, page.label)}
                />
              </li>
            ))
          }
        </ul>
      </nav>
      </div>
    </div>
    <div class="signature">
      <p lang="en">{artistName}</p>
      {/* The sign before the year in every language: a page written right to left would move it after. */}
      <p dir="ltr">©{year}</p>
    </div>
  </Container>
</footer>

<style>
  /* The sizes of the name and the year follow the width of the page within its margins. */
  .footer {
    container-type: inline-size;
  }

  /*
   * The line across the page that ends what is above, as in the mockup. The newsletter stands at
   * the start, the networks and the menu at the end; where the three do not fit on one row, the
   * newsletter takes a row of its own above them.
   */
  /*
   * The newsletter is as high as the menu beside it, as in the mockup: its top is the top of the
   * first link, its bottom the baseline of the last.
   */
  .top {
    /*
     * The menu sets the height of the row. A row of it is as high as a finger needs on a touch
     * screen; under a mouse the rows stand as close as in the mockup, 1.4 times the text, which
     * keeps the newsletter beside it at the size of the mockup. Its capitals are 0.7 of its size.
     */
    --menu-font-size: var(--font-size-1);
    --menu-row: var(--min-tap-target-size);
    --menu-height: calc((var(--menu-links) - 1) * var(--menu-row) + 0.7 * var(--menu-font-size));

    display: flex;
    flex-wrap: wrap;
    gap: var(--layout-space-8);
    align-items: stretch;
    justify-content: space-between;
    padding-block-start: var(--layout-space-8);
    border-block-start: var(--line-width) solid currentColor;
  }

  /*
   * As wide as its heading on one line: where the menu does not fit beside it, the menu takes the
   * next row rather than the heading a second line.
   */
  .signup {
    --portrait-size: var(--menu-height);

    flex: 0 1 auto;
  }

  .links {
    /*
     * An icon draws at 1.25 times its text. A little larger than the menu, the frames are about as
     * large as on the Contacts page (30px at the width of the mockup): one icon, one size.
     */
    --icon-font-size: calc(1.125 * var(--menu-font-size));
    --icon-size: calc(1.25 * var(--icon-font-size));

    display: flex;
    flex-grow: 1;
    gap: var(--layout-space-8);
    align-items: start;
    justify-content: space-between;
    /*
     * A link has its text in the middle of its row: the box of the links ends at the top of the
     * capitals of the first and at the baseline of the last, as the text of the newsletter does.
     */
    margin-block: calc((var(--menu-row) - 0.7 * var(--menu-font-size)) / -2);
  }

  @media (pointer: fine) {
    .top {
      --menu-row: calc(1.4 * var(--menu-font-size));
    }
  }

  /*
   * On a phone the menu comes first, at the start, and the networks at the end, as in the mockup.
   * Wider, the networks and the menu stand together at the end, the menu last.
   */
  .menu-nav {
    order: -1;
  }

  @container (width >= 40rem) {
    .links {
      justify-content: end;
    }

    .menu-nav {
      order: 0;
    }
  }

  .networks,
  .menu {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /*
   * The top of the frames of the icons stands at the top of the capitals of the first link of the
   * menu, as in the mockup. The capitals of Absans are 0.7 of its size, centered in their row; an
   * icon is centered in a box a finger can hit, and its frame starts 2 units of 24 below its top.
   */
  .networks {
    display: flex;
    /* The room a finger needs around each icon is the gap: about half an icon between frames. */
    gap: 0;
    margin-block-start: calc(
      (var(--menu-row) - 0.7 * var(--menu-font-size)) / 2 -
      (max(var(--min-tap-target-size), var(--icon-size)) - var(--icon-size)) / 2 -
      var(--icon-size) / 12
    );
    font-size: var(--icon-font-size);
  }

  .menu {
    font-size: var(--menu-font-size);
  }

  /* One link under another. */
  .menu > li {
    display: flex;
  }

  .menu .menu-link {
    min-block-size: var(--menu-row);
  }

  /*
   * The name and the year span the page on one line: «Anastasia Turkevich» in Absans is 12.34
   * times as wide as its size, «©2026» 3.49 times, and about three times the size apart, as in the
   * mockup. On a phone that would be too small: the year goes above the name, both as large as the
   * heading of the newsletter, as in the mockup; the name fits a 320px screen at that size (12.34
   * × 23px), and 8cqi keeps it within a narrower one.
   */
  .signature {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5em;
    /* As far below the menu as in the mockup, which a closing block of the page needs. */
    padding-block: var(--layout-space-16) var(--layout-space-8);
    font-size: min(var(--font-size-2), 8cqi);
    line-height: var(--line-height-display);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
    white-space: nowrap;
  }

  @container (width >= 40rem) {
    .signature {
      flex-direction: row;
      justify-content: space-between;
      font-size: 5.25cqi;
    }
  }

  /* The boxes end at the top of the capitals and at the baseline, so the spacing is as it looks. */
  .signature > p {
    margin: 0;
    text-box: trim-both cap alphabetic;
  }
</style>
