---
/**
 * What the menu of the site holds: the name of the artist, the pages large, the switches of the
 * page, the ways to reach the artist and the year, as in the mockup. The year stands alone: the
 * sign of copyright is the footer's.
 *
 * It stands in one of two places. In the menu the button of the header opens (`dialog`), where it
 * unrolls with the menu and the header keeps the switches from a tablet on. Or as the page itself
 * (`page`): the home page, under its hero, without a header, so the switches are here on every
 * screen, and the pages rise into place as the page slides in.
 */
import NetworkLinks from "@/components/blocks/NetworkLinks.astro";
import CurrencySwitch from "@/components/controls/CurrencySwitch.astro";
import LanguageSwitch from "@/components/controls/LanguageSwitch.astro";
import ThemeToggle from "@/components/controls/ThemeToggle.astro";
import Container from "@/components/ui/Container.astro";
import HomeLink from "@/components/ui/HomeLink.astro";
import Picture from "@/components/ui/Picture.astro";
import TextLink from "@/components/ui/TextLink.astro";
import type { ContactLinks } from "@/lib/api/contacts";
import type { Image } from "@/lib/api/image";
import type { Language } from "@/lib/i18n/languages";
import { t } from "@/lib/i18n/translate";
import { localizedPath } from "@/lib/site/localizedPath";
import { menu } from "@/lib/site/menu";
import { longestWordLength } from "@/lib/text/longestWord";

interface Props {
  /** The codes of the currencies in use, for the switch of currencies. */
  currencies: string[];
  /** The heroes of the pages by their id: each fills the plate of its page under the pointer. */
  heroes: Record<string, Image>;
  language: Language;
  /** The links of the artist; none when the API could not give them. */
  links: ContactLinks | undefined;
  /** The path of the page being shown under its language, such as `/contact`. */
  path: string | undefined;
  /** Where it stands: in the menu of the header, or as the page itself, the home page. */
  place: "dialog" | "page";
}

const { currencies, heroes, language, links, path, place } = Astro.props;

// The year of the page as it is served, as in the footer.
const year = new Date().getFullYear();

// The names of the pages in this language, and the letters of the longest word among them, which
// sets their size where the column is narrow.
const pageNames = menu.map((page) => t(language, page.label));
const longestWord = Math.max(...pageNames.map(longestWordLength));

// In the menu, the focus starts on its pages as it opens (see the style). The modal dialog that
// allows it is SiteMenu's, which a linter of this file alone cannot see.
const focusStart = place === "dialog" ? { autofocus: true, tabindex: -1 } : {};
---

<Container class="panel" data-place={place}>
  <HomeLink class="name" current={path === "/"} language={language} />
  <slot name="close" />
  <nav aria-label={t(language, "header.menu")} class="pages" {...focusStart}>
    <ul class="page-list" style={{ "--longest-word": longestWord }}>
      {
        menu.map((page, index) => {
          const hero = page.page === undefined ? undefined : heroes[page.page];

          return (
            <li style={`--item: ${index}`}>
              <TextLink
                class:list={["page-link", { "with-hero": hero }]}
                aria-current={page.path === path ? "page" : undefined}
                href={localizedPath(language, page.path)}
                label={t(language, page.label)}
              >
                {hero && (
                  <span aria-hidden="true" class="plate" slot="icon">
                    <Picture
                      alt=""
                      class="hero"
                      image={hero}
                      sizes="(width >= 75rem) 10vw, 25vw"
                    />
                    <span class="plate-text">{t(language, page.label)}</span>
                  </span>
                )}
              </TextLink>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <div class="settings">
    <CurrencySwitch currencies={currencies} id="menu-currency" language={language} />
    {path !== undefined && <LanguageSwitch id="menu-language" language={language} path={path} />}
    <ThemeToggle id="menu-theme" language={language} />
  </div>
  {
    links && (
      <div class="contacts">
        <NetworkLinks class="networks" label={t(language, "footer.networks")} links={links} />
        {links.email !== "" && (
          <TextLink class="email" href={`mailto:${links.email}`} label={links.email} />
        )}
      </div>
    )
  }
  <p class="year">{year}</p>
</Container>

<style>
  /*
   * The name and the button that closes the menu, when it is one, at the top, where the header has
   * its name and its button. Below, the pages, then the ways to reach the artist at the bottom.
   */
  .panel {
    --menu-font-size: var(--font-size-body);
    /* The room of the name in the header, so the name here is as large and stands over it. */
    --home-link-room: calc(100cqi - var(--grid-gap) - var(--min-tap-target-size));
    display: grid;
    grid-template-areas:
      "name close"
      "pages pages"
      "settings settings"
      "contacts contacts"
      "year year";
    grid-template-rows: auto 1fr auto auto auto;
    /* The name as wide as it is, the button that closes the menu in the rest of the row. */
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--layout-space-8) var(--grid-gap);
    padding-block: var(--layout-space-6) var(--layout-space-8);

    container-type: inline-size;
    font-size: var(--menu-font-size);
  }

  /* As tall as the menu that holds it. */
  .panel[data-place="dialog"] {
    min-block-size: inherit;
  }

  /*
   * The whole screen the hero leaves it, as the menu on a phone: the bars of a phone's browser,
   * gone as the visitor scrolled, leave no gap at its bottom.
   */
  .panel[data-place="page"] {
    min-block-size: 100lvh;
  }

  /*
   * On a laptop, as in the mockup: the name and the year in the first two thirds, everything else
   * in the last third, from the button that closes the menu down to the ways to reach the artist.
   * As a page, the switches stand in that third too, between the pages and the ways to reach.
   */
  @media (width >= 75rem) {
    .panel {
      grid-template-areas:
        "name close"
        ". pages"
        "year contacts";
      grid-template-rows: auto 1fr auto;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .panel[data-place="page"] {
      grid-template-areas:
        "name close"
        ". pages"
        ". settings"
        "year contacts";
      grid-template-rows: auto 1fr auto auto;
    }
  }

  .name {
    grid-area: name;
    justify-self: start;
  }

  .pages {
    grid-area: pages;
    container-type: inline-size;
  }

  /*
   * As the menu opens, the focus starts on its pages, not on its first button: Safari draws the
   * ring of the keyboard around a button focused so even after a click of the mouse, and Chrome
   * passes over a mark on the dialog itself. A screen reader names the list, Tab goes on to its
   * first page, Escape closes the menu. The list is no control, so it has no ring of its own.
   */
  .pages:focus-visible {
    outline: none;
  }

  /* The switches of the page, under the pages. */
  .settings {
    display: flex;
    flex-wrap: wrap;
    grid-area: settings;
    gap: 0 var(--layout-space-8);
    align-items: center;
  }

  /* In the menu, only on a phone: the header shows them from 48rem. */
  @media (width >= 48rem) {
    [data-place="dialog"] .settings {
      display: none;
    }
  }

  .page-list {
    padding: 0;
    margin: 0;
    /*
     * A name never breaks: in a narrow column a language of long names, such as the Dutch
     * «Tentoonstellingen», sets all of them smaller, so its longest word fits the line. A capital
     * of Absans is about 0.8 of its size wide.
     */
    font-size: min(var(--font-size-3), 100cqi / (0.8 * var(--longest-word)));
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
    list-style: none;
  }

  /*
   * One page under another, on the line of everything else in the column; the rows stand apart
   * nearly twice their text, as the plates of the mockup do.
   */
  .page-list > li {
    display: flex;
  }

  .page-list .page-link {
    min-block-size: 1.85em;
  }

  /* As the menu opens, the pages rise into place one after another. */
  [data-place="dialog"] .page-list > li {
    transition-delay: calc(var(--item) * var(--motion-stagger));
    transition-timing-function: var(--motion-easing-standard);
    transition-duration: var(--motion-duration-panel);
    transition-property: opacity, translate;
  }

  @starting-style {
    :global(dialog[open]) [data-place="dialog"] .page-list > li {
      opacity: 0;
      translate: 0 0.3em;
    }
  }

  /*
   * As a page, they rise one after another as the page slides in after the hero, driven by the
   * scroll: each has risen by the time the top of the page meets the top of the screen. A browser
   * without scroll-driven animations, or a screen without motion, shows them in place.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      [data-place="page"] {
        view-timeline: --menu-page block;
      }

      [data-place="page"] .page-list > li {
        animation: rise linear both;
        animation-timeline: --menu-page;
        animation-range: entry calc(40% + var(--item) * 10%) entry calc(60% + var(--item) * 10%);
      }
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.3em;
    }
  }

  /*
   * Under the pointer, or the focus of the keyboard, the hero of the page fills a plate over its
   * name, as in the mockup: as wide as the word and half a letter more on each side, so the name
   * keeps the line of the column. The work is blurred, as the hero is at the top of its page, and
   * darkened, and the plate holds the name again in white, hidden from screen readers. It fills
   * from the start of the word to its end, as a stroke of a brush, and drains back the same way:
   * the name turns white exactly as far as the stroke has gone. The blur hides the detail, so a
   * small file is enough. Without a pointer, on a phone, there is no plate, and its photo is never
   * loaded: a hidden image is not fetched.
   */
  .plate {
    display: none;
  }

  @media (hover: hover) {
    .with-hero {
      position: relative;
    }

    .plate {
      position: absolute;
      inset: 0 -0.5em;
      display: flex;
      align-items: center;
      padding-inline: 0.5em;
      container-type: size;
      overflow: hidden;
      color: var(--color-on-photo);
      clip-path: inset(0 100% 0 0);
      transition: clip-path var(--motion-duration-panel) var(--motion-easing-standard);
    }

    .plate:dir(rtl) {
      clip-path: inset(0 0 0 100%);
    }

    /*
     * Blurred twice as much as the hero for its size (1.5% of its longer side): the plate shows the
     * work much smaller, so its detail is finer and, blurred as little, would stay sharp enough to
     * cross the name; so blurred, it keeps the colors and the rhythm of the work, a small hero.
     * Blurred edges would let the page show through, so the photo is a little larger than its plate.
     */
    .hero {
      position: absolute;
      inset: 0;
      max-inline-size: none;
    }

    .hero :global(img) {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      filter: blur(1.5cqmax) brightness(0.6);
      scale: 1.1;
    }

    /* The name on the plate stands exactly over the one under it. */
    .plate-text {
      position: relative;
      text-box: trim-both cap alphabetic;
      white-space: nowrap;
    }

    /*
     * A plate is lit under the pointer or the focus, and the page being shown is lit from the
     * moment the menu opens, so the visitor sees where they are. One plate is lit at a time: while
     * another is pointed at, the one of the page being shown drains, and it fills again after.
     */
    .with-hero:is(:hover, :focus-visible, [aria-current="page"]) .plate {
      clip-path: inset(0);
    }

    .page-list:has(.with-hero:is(:hover, :focus-visible))
      .with-hero[aria-current="page"]:not(:hover, :focus-visible)
      .plate {
      clip-path: inset(0 100% 0 0);
    }

    .page-list:has(.with-hero:is(:hover, :focus-visible))
      .with-hero[aria-current="page"]:not(:hover, :focus-visible)
      .plate:dir(rtl) {
      clip-path: inset(0 0 0 100%);
    }

    /* The stroke is the sign of the pointer here: the underline of a link gives way to it. */
    .page-link.with-hero:is(:hover, :focus-visible) :global(.text) {
      text-decoration-color: transparent;
    }

    /* As the menu unrolls, the plate of the page being shown fills with it. */
    @starting-style {
      :global(dialog[open]) .with-hero[aria-current="page"] .plate {
        clip-path: inset(0 100% 0 0);
      }

      :global(dialog[open]) .with-hero[aria-current="page"] .plate:dir(rtl) {
        clip-path: inset(0 0 0 100%);
      }
    }
  }

  /*
   * The ways to reach the artist: the icons of the networks, then the address, which on a phone
   * goes under them rather than break.
   */
  .contacts {
    display: flex;
    flex-wrap: wrap;
    grid-area: contacts;
    gap: 0 var(--layout-space-4);
    align-items: center;
  }

  /* The frame of the first icon, not the room a finger needs around it, starts at the edge. */
  .networks {
    --icon-size: 1.25em;

    margin-inline-start: calc(
      (var(--icon-size) - max(var(--min-tap-target-size), var(--icon-size))) / 2 -
      var(--icon-size) / 12
    );
  }

  .year {
    grid-area: year;
    align-self: end;
    margin: 0;
    line-height: var(--min-tap-target-size);
  }
</style>
