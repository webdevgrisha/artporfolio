---
/**
 * The newsletter in the footer: the portrait of the artist, the heading, and the field of the
 * address. Without JavaScript the form posts to the page, which comes back with the outcome; with
 * it, the outcome shows in place.
 */
import { actions, isInputError } from "astro:actions";
import { Picture } from "astro:assets";
import type { HTMLAttributes } from "astro/types";

import portrait from "@/assets/images/portraitMark.png";
import ChevronIcon from "@/components/ui/icons/ChevronIcon.astro";
import VisuallyHidden from "@/components/ui/VisuallyHidden.astro";
import type { Language } from "@/lib/i18n/languages";
import { t } from "@/lib/i18n/translate";

interface Props extends HTMLAttributes<"section"> {
  language: Language;
}

const { class: className, language, ...attributes } = Astro.props;

// The outcome of a form posted without JavaScript; the script below tells the same apart.
const result = Astro.getActionResult(actions.subscribe);
const outcome = !result
  ? undefined
  : !result.error
    ? "subscribed"
    : isInputError(result.error) || result.error.code === "BAD_REQUEST"
      ? "invalid"
      : "failed";
---

<section
  aria-labelledby="newsletter-heading"
  class:list={["newsletter", className]}
  id="newsletter"
  {...attributes}
>
  {/* At most about 150px wide; each screen takes the file of its density, sharp on a Retina one. */}
  <Picture
    alt=""
    densities={[1, 2, 3]}
    fallbackFormat="webp"
    formats={["avif"]}
    pictureAttributes={{ class: "portrait" }}
    src={portrait}
    width={150}
  />
  <div class="body">
    <h2 class="heading" id="newsletter-heading">{t(language, "newsletter.heading")}</h2>
    {/* Without JavaScript the page comes back at the form, where its outcome is, not at the hero. */}
    <form
      action={`${actions.subscribe}#newsletter`}
      class="form"
      data-newsletter
      data-outcome={outcome}
      method="post"
    >
      <input name="language" type="hidden" value={language} />
      <div class="field">
        <label>
          <VisuallyHidden>{t(language, "newsletter.email")}</VisuallyHidden>
          <input
            aria-describedby="newsletter-status"
            aria-invalid={outcome === "invalid" ? "true" : undefined}
            autocomplete="email"
            class="input"
            maxlength="254"
            name="email"
            placeholder={t(language, "newsletter.email")}
            required
            type="email"
          />
        </label>
        <button class="submit" type="submit">
          <span class="arrow"><ChevronIcon /></span>
          <VisuallyHidden>{t(language, "newsletter.submit")}</VisuallyHidden>
        </button>
      </div>
      {/* Hidden from people, so only a bot fills it: the action then saves nothing. */}
      <label aria-hidden="true" class="trap">
        Website
        <input autocomplete="off" name="website" tabindex="-1" type="text" />
      </label>
      {/* One line under the field, as in the mockup: what the newsletter brings, then the outcome. */}
      <p class="status" id="newsletter-status" role="status">
        <span class="hint" data-message="hint">{t(language, "newsletter.note")}</span>
        <span data-message="subscribed">{t(language, "newsletter.subscribed")}</span>
        <span class="error" data-message="invalid">{t(language, "newsletter.invalid")}</span>
        <span class="error" data-message="failed">{t(language, "newsletter.failed")}</span>
      </p>
    </form>
  </div>
</section>

<script>
  import { actions, isInputError } from "astro:actions";

  // Sends the form in place, so the page keeps its scroll and shows the outcome under the field.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-newsletter]")) {
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const submit = form.querySelector("button") as HTMLButtonElement;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (form.dataset.sending !== undefined) return;

      // The last outcome goes while the form is sent, so the new one shows and is read anew.
      delete form.dataset.outcome;
      form.dataset.sending = "";
      submit.disabled = true;
      const sent = email.value;
      let outcome: "subscribed" | "invalid" | "failed";

      try {
        const { error } = await actions.subscribe(new FormData(form));
        outcome = !error
          ? "subscribed"
          : isInputError(error) || error.code === "BAD_REQUEST"
            ? "invalid"
            : "failed";
      } catch {
        // No answer came, such as offline: the address stays, so the visitor can send it again.
        outcome = "failed";
      } finally {
        delete form.dataset.sending;
        submit.disabled = false;
      }

      form.dataset.outcome = outcome;
      if (outcome === "invalid") email.setAttribute("aria-invalid", "true");
      else email.removeAttribute("aria-invalid");
      // Only the address that subscribed goes: one typed while it was sent is the visitor's next.
      if (outcome === "subscribed" && email.value === sent) email.value = "";
    });
  }
</script>

<style>
  /*
   * As high as the portrait: the heading at its top, the field at its bottom.
   */
  .newsletter {
    display: flex;
    gap: var(--layout-space-4);
    align-items: stretch;
  }

  /*
   * As high as the block where the footer says so (`--portrait-size`, the height of its menu under
   * a mouse), and shown where it says so (`--portrait-display`): on a phone and a small tablet the
   * heading and the field need the width, as in the mockup of a phone.
   */
  .portrait {
    display: var(--portrait-display, block);
    flex-shrink: 0;
    align-self: start;
    inline-size: var(--portrait-size, var(--layout-space-24));
    aspect-ratio: 1;
  }

  .portrait > img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .body {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    /* At least this far apart; beside the menu, as far as its height takes them. */
    gap: var(--layout-space-6);
    justify-content: space-between;
    min-inline-size: 0;
  }

  .heading {
    margin: 0;
    font-size: var(--font-size-2);
    /* The box ends at the top of the capitals, so they line up with the top of the portrait. */
    text-box: trim-both cap alphabetic;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
  }

  /* As wide as an address needs, or as the footer says (`--form-max-size`). */
  .form {
    max-inline-size: var(--form-max-size, 27rem);
  }

  /* The field is a line, as in the mockup, with the arrow that sends it at its end. */
  .field {
    position: relative;
    display: flex;
    align-items: center;
    padding-block-end: var(--space-2);
    border-block-end: var(--line-width) solid var(--color-line);
  }

  /*
   * In the field, a line twice as thick draws over the thin one from where the text starts: the
   * focus of a field that is only a line, in place of a frame around it.
   */
  .field::after {
    position: absolute;
    inset-block-end: calc(-1 * var(--line-width));
    inset-inline: 0;
    block-size: calc(2 * var(--line-width));
    content: "";
    background: var(--color-text);
    transform-origin: left;
    scale: 0 1;
    transition: scale var(--motion-duration-slow) var(--motion-easing-standard);
  }

  .field:dir(rtl)::after {
    transform-origin: right;
  }

  .field:has(.input:focus-visible)::after {
    scale: 1 1;
  }

  .form[data-outcome="invalid"] .field {
    border-color: var(--color-error);
  }

  .form[data-outcome="invalid"] .field::after {
    background: var(--color-error);
  }

  .field > label {
    flex-grow: 1;
    min-inline-size: 0;
  }

  .input {
    inline-size: 100%;
    min-block-size: var(--min-tap-target-size);
    padding: 0;
    font: inherit;
    font-size: var(--font-size-1);
    color: inherit;
    background: transparent;
    border: 0;
  }

  /* The line under the field shows its focus. */
  .input:focus-visible {
    outline: none;
  }

  .input::placeholder {
    color: var(--color-text-muted);
  }

  /*
   * The arrow ends where the line ends, as in the mockup, in the middle of a box a finger can hit,
   * so the ring of the focus is even around it. The ring is there with the whole arrow, stem and
   * lean (ChevronIcon): from 13 units before the box of the chevron to 17 after its start, in units
   * of 1/24em, so 4 units before its middle. The padding moves the chevron forward by those 4, so the
   * arrow is in the middle; the box then reaches past the end of the line by as much as it must for
   * the tip (10 units after the middle) to stay there.
   */
  .submit {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--min-tap-target-size);
    min-block-size: var(--min-tap-target-size);
    padding: 0 0 0 calc(8em / 24);
    margin-inline-end: calc(10em / 24 - var(--min-tap-target-size) / 2);
    font-size: var(--font-size-1);
    color: inherit;
    cursor: pointer;
    background: transparent;
    border: 0;
  }

  .submit:disabled {
    cursor: progress;
  }

  /*
   * The arrow is the gesture of sending. Under the pointer, or in focus, a stem as thin as the line
   * grows back from its tip, so the chevron becomes an arrow, and it leans forward. While the
   * address is sent it breathes; once it is in, it flies off ahead and comes back. Forward is to
   * the left in Arabic.
   */
  .arrow {
    --forward: 1;

    display: inline-flex;
  }

  .arrow:dir(rtl) {
    --forward: -1;
  }

  @media (hover: hover) {
    .submit:hover .arrow {
      --chevron-stem: 1;
      --chevron-lean: 1;
    }
  }

  .submit:focus-visible .arrow {
    --chevron-stem: 1;
    --chevron-lean: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .form[data-sending] .arrow {
      animation: breathe calc(3 * var(--motion-duration-slow)) var(--motion-easing-standard)
        infinite alternate;
    }

    .form[data-outcome="subscribed"] .arrow {
      animation: send calc(3 * var(--motion-duration-slow)) var(--motion-easing-standard);
    }
  }

  @keyframes breathe {
    to {
      opacity: 0.3;
    }
  }

  @keyframes send {
    45% {
      opacity: 0;
      translate: calc(var(--forward) * 1.5em) 0;
    }

    55% {
      opacity: 0;
      translate: calc(var(--forward) * -0.75em) 0;
    }
  }

  .trap {
    display: none;
  }

  /* The box ends at the baseline, the bottom of the block, as the last link of the menu does. */
  .status {
    margin: 0;
    margin-block-start: var(--space-3);
    font-size: var(--font-size-body);
    text-box: trim-both cap alphabetic;
  }

  .hint {
    color: var(--color-text-muted);
  }

  /* The hint until the form is sent, then only its outcome; screen readers read it as it changes. */
  .status > span {
    display: none;
  }

  .form:not([data-outcome]) [data-message="hint"],
  .form[data-outcome="subscribed"] [data-message="subscribed"],
  .form[data-outcome="invalid"] [data-message="invalid"],
  .form[data-outcome="failed"] [data-message="failed"] {
    display: inline;
  }

  .error {
    color: var(--color-error);
  }
</style>
