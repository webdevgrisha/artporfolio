---
/**
 * The photos of the work in progress at the end of the About page, as a row to swipe; the design
 * shows no heading, so it is there for screen readers only.
 */
import PhotoCarousel from "@/components/ui/PhotoCarousel.astro";
import Reveal from "@/components/ui/Reveal.astro";
import VisuallyHidden from "@/components/ui/VisuallyHidden.astro";
import type { Photo } from "@/lib/api/image";
import type { ViewerLabels } from "@/lib/site/photoViewer";

interface Props {
  /** The id of its heading, which names the row for screen readers. */
  id: string;
  heading: string;
  /** The texts of the buttons under the row. */
  next: string;
  previous: string;
  /** At least one. */
  photos: Photo[];
  viewer: ViewerLabels;
}

const { heading, id, ...carousel } = Astro.props;
---

<Reveal as="section" aria-labelledby={id}>
  <VisuallyHidden as="h2" id={id}>{heading}</VisuallyHidden>
  <PhotoCarousel {...carousel} fit="row" />
</Reveal>
