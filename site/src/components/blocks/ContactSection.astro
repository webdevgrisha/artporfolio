---
/**
 * The Contacts page: the title of the page for screen readers, the heading «Get in touch» with the
 * ways to reach the artist, and the contact photo beside them, or under them on a phone.
 */
import Container from "@/components/ui/Container.astro";
import IconLink from "@/components/ui/IconLink.astro";
import InstagramIcon from "@/components/ui/icons/InstagramIcon.astro";
import LinkedInIcon from "@/components/ui/icons/LinkedInIcon.astro";
import MailIcon from "@/components/ui/icons/MailIcon.astro";
import YouTubeIcon from "@/components/ui/icons/YouTubeIcon.astro";
import Picture from "@/components/ui/Picture.astro";
import VisuallyHidden from "@/components/ui/VisuallyHidden.astro";
import type { ContactLinks } from "@/lib/api/contacts";
import type { Photo } from "@/lib/api/image";
import { splitTurnedInitial } from "@/lib/text/turnedInitial";

interface Props {
  heading: string;
  links: ContactLinks;
  photo: Photo | null;
  /** The title of the page; the hero will show it once pages have one. */
  title: string;
}

const { heading, links, photo, title } = Astro.props;
const turned = splitTurnedInitial(heading);

// In the order of the mockup. The email is shown as the address, which a visitor can copy when
// no mail app opens; a network by its name. A link the artist left empty is not shown.
//
// The name of a network is English in every language of the page: set as such, it keeps its letters
// in capitals (in Turkish, «LinkedIn» would get the dotted İ) and a screen reader says it right.
const contacts = [
  { href: links.instagram, Icon: InstagramIcon, label: "Instagram", lang: "en" },
  { href: links.linkedin, Icon: LinkedInIcon, label: "LinkedIn", lang: "en" },
  { href: links.email && `mailto:${links.email}`, Icon: MailIcon, label: links.email },
  { href: links.youtube, Icon: YouTubeIcon, label: "YouTube", lang: "en" },
].filter(({ href }) => href !== "");
---

<Container as="section" aria-labelledby="contact-heading">
  <VisuallyHidden as="h1">{title}</VisuallyHidden>
  <div class:list={["layout", { "has-photo": photo }]}>
    <div class="body">
      <h2 class="heading" id="contact-heading">
        {
          turned ? (
            <>
              <span class="turned">{turned.initial}</span>
              {turned.rest}
            </>
          ) : (
            heading
          )
        }
      </h2>
      <ul class="links">
        {
          contacts.map(({ href, Icon, label, lang }) => (
            <li>
              <IconLink
                class:list={["link", { email: href.startsWith("mailto:") }]}
                href={href}
                label={label}
                lang={lang}
              >
                <Icon slot="icon" />
              </IconLink>
            </li>
          ))
        }
      </ul>
    </div>
    {
      photo && (
        <Picture
          alt={photo.alt}
          class="photo"
          image={photo}
          priority
          sizes="(min-width: 75rem) 40vw, (min-width: 40rem) 50vw, 100vw"
        />
      )
    }
  </div>
</Container>

<style>
  .layout {
    display: grid;
    /* One column on a phone, which never grows past the screen to fit a long word or the photo. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--layout-space-12) var(--layout-space-16);
    padding-block: var(--layout-space-16);
  }

  /* The sizes of the text follow the width of its column, as the heading spans it whole. */
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--layout-space-12);
    container-type: inline-size;
  }

  .photo {
    /* The frame of the mockup, which the admin previews the photo in too. */
    aspect-ratio: 764 / 534;
  }

  /*
   * As wide as its column: «Get in touch» in Absans is about 7.4 times as wide as its size, so it
   * fills the column from edge to edge at every width. A longer heading of another language goes
   * on two lines.
   *
   * A letter has some empty room at its sides, and the last one is followed by the spacing between
   * letters: at this size the last letter itself ends on the margin of the page, as far from the
   * edge as the photo is, while its box goes past the column by that room (0.085em after the H of
   * Absans) and a little more, so a browser that measures the text a hair wider never wraps it.
   */
  .heading {
    margin-inline-end: calc(-0.085em - var(--letter-spacing-caps) - 0.05em);
    font-size: min(var(--font-size-display), 13.63cqi);
    line-height: var(--line-height-display);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
    text-wrap: balance;
    /* A word too long for the column breaks by its syllables rather than run off the screen. */
    overflow-wrap: break-word;
    hyphens: auto;
    /* Only a long word: balancing the lines must not break a word that fits. */
    hyphenate-limit-chars: 14 6 6;
    /* The box ends at the top of the capitals, so they line up with the top of the photo. */
    text-box: trim-both cap alphabetic;
  }

  /*
   * Beside each other from a tablet on, in the proportions of the mockup: the photo, then the
   * text as high as the photo, with the heading at its top and the links at its bottom. A text
   * higher than the photo, on a narrow tablet or in a long language, only makes the row higher.
   */
  @media (width >= 40rem) {
    .layout.has-photo {
      grid-template-columns: minmax(0, 764fr) minmax(0, 904fr);
    }

    .has-photo .body {
      grid-row: 1;
      grid-column: 2;
      justify-content: space-between;
    }

    .has-photo .photo {
      grid-row: 1;
      grid-column: 1;
      align-self: start;
    }
  }

  /* The G upside down, as in the mockup. */
  .turned {
    display: inline-block;
    rotate: 180deg;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 0.75em;
    padding: 0;
    margin: 0;
    /*
     * A link is as high as a finger needs, with its text in the middle: the list goes down by the
     * room under the last line, so its baseline is the bottom of the photo, as in the mockup.
     */
    margin-block-end: calc((max(var(--min-tap-target-size), 1.25em) - 1cap) / -2);
    /*
     * Smaller than the heading in step with it, but not so small on a laptop that the list looks
     * weak, nor so large on a wide screen that it competes with the heading.
     */
    font-size: clamp(var(--font-size-1), 3cqi, var(--font-size-3));
    list-style: none;
  }

  /* The link alone, without the line of text an inline box sits on and its room for descenders. */
  .links > li {
    display: flex;
  }

  .link {
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
  }

  /* An address keeps its letters, so it reads and copies as it is written. */
  .link.email {
    text-transform: none;
    letter-spacing: normal;
  }
</style>
