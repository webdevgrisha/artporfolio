---
import ContactSection from "@/components/blocks/ContactSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contactsSchema } from "@/lib/api/contacts";
import { getJson } from "@/lib/api/getJson";
import { isLanguage } from "@/lib/i18n/languages";
import { t } from "@/lib/i18n/translate";

const { lang } = Astro.params;

if (!isLanguage(lang)) {
  return Astro.rewrite("/404");
}

const { links, photo } = await getJson("contacts", contactsSchema, { language: lang });
const title = t(lang, "contact.title");
---

<BaseLayout
  description={t(lang, "contact.description")}
  language={lang}
  path="/contact"
  title={title}
>
  <ContactSection heading={t(lang, "contact.heading")} links={links} photo={photo} title={title} />
</BaseLayout>
