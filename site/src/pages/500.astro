---
import ErrorNotice from "@/components/blocks/ErrorNotice.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { languageOfPath } from "@/lib/i18n/languageOfPath";
import { t } from "@/lib/i18n/translate";

const language = languageOfPath(Astro.url.pathname);
const title = t(language, "error.server.title");
---

{/* As a missing page: alone on the screen, without the footer, whose networks need the API. */}
<BaseLayout frame="none" language={language} title={title}>
  <ErrorNotice
    code={["5", "0"]}
    language={language}
    text={t(language, "error.server.text")}
    title={title}
  />
</BaseLayout>
