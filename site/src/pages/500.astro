---
import ErrorNotice from "@/components/blocks/ErrorNotice.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { languageOfPath } from "@/lib/i18n/languageOfPath";
import { t } from "@/lib/i18n/translate";

const language = languageOfPath(Astro.url.pathname);
const title = t(language, "error.server.title");
---

<BaseLayout language={language} title={title}>
  <ErrorNotice language={language} text={t(language, "error.server.text")} title={title} />
</BaseLayout>
