---
import NotFoundNotice from "@/components/blocks/NotFoundNotice.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { languageOfPath } from "@/lib/i18n/languageOfPath";
import { t } from "@/lib/i18n/translate";

const language = languageOfPath(Astro.url.pathname);
---

<BaseLayout footer={false} language={language} title={t(language, "error.notFound.title")}>
  <NotFoundNotice language={language} />
</BaseLayout>
