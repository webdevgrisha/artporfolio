---
/**
 * What search engines and link cards read about a page: its title, description, address and
 * the same page in the other languages.
 */
import { SITE_URL } from "astro:env/server";

import type { Language } from "@/lib/i18n/languages";
import { alternateLinks } from "@/lib/seo/alternateLinks";
import { localizedPath } from "@/lib/site/localizedPath";
import { siteName } from "@/lib/site/siteName";

interface Props {
  description?: string | undefined;
  language: Language;
  /** The path of the page under its language, such as `/contact`. */
  path: string;
  title: string;
}

const { description, language, path, title } = Astro.props;
const url = new URL(localizedPath(language, path), SITE_URL).href;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={url} />
{alternateLinks(path, SITE_URL).map(({ href, hreflang }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={url} />
