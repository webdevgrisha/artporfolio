{
  "name": "artportfolio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/firebase.js",
  "engines": {
    "node": "22"
  },
  "imports": {
    "#*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm type-check && pnpm openapi:lint",
    "openapi": "node --conditions=development --experimental-transform-types --no-warnings openapi/generate.ts",
    "openapi:lint": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint openapi/openapi.yaml --config openapi/redocly.yaml"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "helmet": "^8.3.0",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.0",
    "@types/busboy": "1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "~5.9.3",
    "yaml": "2.9.1",
    "zod-openapi": "6.0.2"
  }
}
